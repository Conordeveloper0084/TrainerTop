# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (TrainerTop AI uchun)
OPENAI_API_KEY=your-openai-key

# Cloudflare R2 (Media storage)
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=trainertop-media
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Click.uz (to'lov tizimi)
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# Sayt URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google bilan kirish tugmasi (Supabase'da Google sozlangach true qiling, keyin Redeploy)
NEXT_PUBLIC_GOOGLE_LOGIN=false

# --- Support javoblarini emailga yuborish (ixtiyoriy) ---
# Resend → API Keys → "Sending access" kalit yarating. Domen (trainertop.uz) allaqachon tasdiqlangan.
# Kalit bo'lmasa: kirgan foydalanuvchiga javob qo'ng'iroqchaga boradi, mehmonga email AVTOMATIK yuborilmaydi
# (admin paneli buni ko'rsatadi va emailga qo'lda yozish tugmasini beradi).
# RESEND_API_KEY=re_xxxxxxxx
# SUPPORT_FROM_EMAIL=TrainerTop Support <support@trainertop.uz>

# Support bot (@TrainerTop_Support_Bot) tokeni — ixtiyoriy. Bor bo'lsa admin panelidan Telegram murojaatlariga javob berish mumkin.
# Yo'q bo'lsa Telegram murojaatlari faqat o'qiladi.
TELEGRAM_BOT_TOKEN=
